{
    "name": "rac-compiler",
    "displayName": "RAC Compiler",
    "description": "Language support, build, and run integration for RAC Compiler",
    "version": "0.0.2",
    "publisher": "luongvantam",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "rsc",
                "aliases": [
                    "RSC",
                    "rsc"
                ],
                "extensions": [
                    ".rsc"
                ]
            }
        ],
        "grammars": [
            {
                "language": "rsc",
                "scopeName": "source.rsc",
                "path": "./syntaxes/rsc.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "rsc.run",
                "title": "RSC: Run",
                "icon": "$(play)"
            },
            {
                "command": "rsc.selectModel",
                "title": "RSC: Select Model"
            },
            {
                "command": "rsc.selectMode",
                "title": "RSC: Select Mode"
            },
            {
                "command": "rsc.setCompilerPath",
                "title": "RSC: Set Compiler Path"
            },
            {
                "command": "rsc.debug",
                "title": "RSC: Run & Debug",
                "icon": "$(debug-alt)"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "RAC Compiler",
            "properties": {
                "racCompiler.path": {
                    "type": "string",
                    "default": "",
                    "description": "Absolute path to the RAC-Compiler directory (where rac.py is located). Leave empty to attempt auto-detection from workspace."
                }
            }
        },
        "menus": {
            "editor/title/run": [
                {
                    "command": "rsc.run",
                    "when": "resourceLangId == rsc",
                    "group": "navigation"
                }
            ]
        },
        "debuggers": [
            {
                "type": "rsc",
                "label": "RAC Compiler",
                "languages": [
                    "rsc"
                ],
                "initialConfigurations": [
                    {
                        "type": "rsc",
                        "request": "launch",
                        "name": "Run RSC File",
                        "program": "${file}"
                    }
                ]
            }
        ]
    },
    "main": "./src/extension.js",
    "activationEvents": [
        "onLanguage:rsc",
        "onDebugResolve:rsc"
    ]
}