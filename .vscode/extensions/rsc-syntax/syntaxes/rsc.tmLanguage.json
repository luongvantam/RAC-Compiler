{
    "name": "RSC Script (Casio Compiler)",
    "scopeName": "source.rsc",

    "fileTypes": [
        "rsc"
    ],

    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#memory"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#registers"
        },
        {
            "include": "#hexstream"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keys"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#deprecated"
        }
    ],

    "repository": {

        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.rsc",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.rsc",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.rsc",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.rsc",
                            "match": "~"
                        },
                        {
                            "name": "variable.interpolation.rsc",
                            "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.token.rsc",
                    "begin": "'",
                    "end": "'"
                }
            ]
        },

        "memory": {
            "patterns": [
                {
                    "match": "\\b(org|backup)\\s+(0x[0-9A-Fa-f]+|\\d+)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.memory.rsc"
                        },
                        "2": {
                            "name": "constant.numeric.address.rsc"
                        }
                    }
                },

                {
                    "match": "\\b(dist)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "support.function.distance.rsc"
                        },
                        "2": {
                            "name": "punctuation.accessor.rsc"
                        },
                        "3": {
                            "name": "entity.name.namespace.rsc"
                        }
                    }
                }
            ]
        },

        "directives": {
            "patterns": [
                {
                    "match": "^\\s*(@(set|section))(\\.([A-Za-z0-9_]+))",
                    "captures": {
                        "1": {
                            "name": "keyword.control.directive.rsc"
                        },
                        "3": {
                            "name": "punctuation.accessor.rsc"
                        },
                        "4": {
                            "name": "entity.name.namespace.rsc"
                        }
                    }
                }
            ]
        },

        "labels": {
            "patterns": [
                {
                    "name": "entity.name.label.definition.rsc",
                    "match": "\\blbl\\s+[A-Za-z_][A-Za-z0-9_]*\\b"
                },
                {
                    "name": "entity.name.label.rsc",
                    "match": "^\\s*[A-Za-z_][A-Za-z0-9_]*:"
                },
                {
                    "name": "entity.name.label.reference.rsc",
                    "match": "(?<=\\bgoto\\s)[A-Za-z_][A-Za-z0-9_]*"
                }
            ]
        },

        "functions": {
            "patterns": [
                {
                    "name": "storage.type.function.rsc",
                    "match": "\\b(func|def)\\b"
                },
                {
                    "name": "entity.name.function.definition.rsc",
                    "match": "(?<=\\b(func|def)\\s)[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                    "name": "entity.name.function.call.rsc",
                    "match": "(?<=\\bcall\\s)[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                    "name": "support.function.builtin.rsc",
                    "match": "\\b(adr|adr_of|adr_arith|eval|calc)\\b"
                },
                {
                    "name": "support.class.python.rsc",
                    "match": "\\bpy\\b"
                },
                {
                    "name": "entity.name.function.python.rsc",
                    "match": "(?<=\\bpy\\.)[A-Za-z_][A-Za-z0-9_]*"
                }
            ]
        },

        "keywords": {
            "patterns": [
                {
                    "name": "storage.modifier.rsc",
                    "match": "\\b(var|reg|loop)\\b"
                },
                {
                    "name": "keyword.control.rsc",
                    "match": "\\b(call|goto|return|at)\\b"
                },
                {
                    "name": "keyword.operator.word.rsc",
                    "match": "\\b(in|and|or|not)\\b"
                }
            ]
        },

        "registers": {
            "patterns": [
                {
                    "name": "variable.other.register.rsc",
                    "match": "\\b((er|xr|qr|r)[0-9]{1,2}|sp|pc|ea)\\b",
                    "flags": "i"
                }
            ]
        },

        "hexstream": {
            "patterns": [
                {
                    "begin": "\\bhex\\b",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.hex.rsc"
                        }
                    },
                    "end": "$",
                    "patterns": [
                        {
                            "name": "constant.numeric.hex.byte.rsc",
                            "match": "\\b[0-9A-Fa-f]{2}\\b"
                        }
                    ]
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.rsc",
                    "match": "\\b0x[0-9A-Fa-f]+\\b"
                },
                {
                    "name": "constant.numeric.decimal.rsc",
                    "match": "\\b\\d+\\b"
                }
            ]
        },

        "keys": {
            "patterns": [
                {
                    "name": "constant.other.keycode.rsc",
                    "match": "\\bKEY_[A-Z0-9_]+\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.rsc",
                    "match": "=|\\+|\\-|\\*|\\/|%|==|!=|<=|>=|<|>"
                }
            ]
        },

        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.rsc",
                    "match": ",|;|:"
                },
                {
                    "name": "punctuation.definition.parameters.rsc",
                    "match": "\\(|\\)|\\[|\\]"
                },
                {
                    "name": "punctuation.section.block.rsc",
                    "match": "\\{|\\}"
                }
            ]
        },

        "deprecated": {
            "patterns": [
                {
                    "name": "invalid.deprecated.rsc",
                    "match": "\\b(def|find_gadgets)\\b"
                }
            ]
        }
    }
}